#!/bin/sh
# Pre-commit hook for lemgendary-ai-studio-gui
echo "[PRE-COMMIT] Running LemGendary AI Studio GUI Verification Suite..."
python verify_gui.py --staged
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
    echo "[PRE-COMMIT] Verification failed with exit code $EXIT_CODE. Aborting commit."
    exit $EXIT_CODE
fi
exit 0
